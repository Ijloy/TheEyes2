# Texto: Git normaliza los saltos de línea
* text=auto

# Archivos YAML de Unity: siempre LF, como los escribe el editor
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.inputactions text eol=lf

# Código
*.cs text diff=csharp

# Binarios
*.png binary
*.jpg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
